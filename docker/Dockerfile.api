FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY TixeNex.slnx ./

COPY src/TixeNex.Shared/TixeNex.Shared.csproj src/TixeNex.Shared/
COPY src/TixeNex.Api/TixeNex.Api.csproj src/TixeNex.Api/

RUN dotnet restore src/TixeNex.Api/TixeNex.Api.csproj

COPY . .

RUN dotnet publish src/TixeNex.Api/TixeNex.Api.csproj \
    -c Release \
    -o /app/publish \
    --no-restore \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

COPY --from=build /app/publish .

RUN mkdir -p /app/App_Data/attachments

EXPOSE 8080

ENTRYPOINT ["dotnet", "TixeNex.Api.dll"]