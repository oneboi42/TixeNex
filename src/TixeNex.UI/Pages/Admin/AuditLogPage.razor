@page "/admin/audit"
@attribute [Authorize(Roles = "Admin")]

@using System.Net.Http.Json
@using System.Text.Json
@using TixeNex.Shared.Contracts.Audit
@using Microsoft.AspNetCore.Authorization

@inject IHttpClientFactory HttpClientFactory

<PageTitle>Audit Log</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">Audit Log</h3>
        <div class="text-muted">
            Recent administrative and ticket activity in your workspace
        </div>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary"
                disabled="@_loading"
                @onclick="LoadAsync">
            Refresh
        </button>

        <NavLink class="btn btn-outline-secondary"
                 href="tickets/deleted">
            Go to recycle bin
        </NavLink>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title mb-3">Filters</h5>

        <div class="row g-3">
            <div class="col-md-2">
                <label class="form-label"
                       for="actionFilter">
                    Action
                </label>

                <input id="actionFilter"
                       class="form-control"
                       @bind="_action"
                       placeholder="e.g. Create" />
            </div>

            <div class="col-md-2">
                <label class="form-label"
                       for="entityNameFilter">
                    Entity
                </label>

                <input id="entityNameFilter"
                       class="form-control"
                       @bind="_entityName"
                       placeholder="e.g. Ticket" />
            </div>

            <div class="col-md-3">
                <label class="form-label"
                       for="performedByFilter">
                    Performed by
                </label>

                <input id="performedByFilter"
                       class="form-control"
                       @bind="_performedBy"
                       placeholder="name or username" />
            </div>

            <div class="col-md-2">
                <label class="form-label"
                       for="fromUtcFilter">
                    From
                </label>

                <input id="fromUtcFilter"
                       class="form-control"
                       type="datetime-local"
                       @bind="_fromUtc" />
            </div>

            <div class="col-md-2">
                <label class="form-label"
                       for="toUtcFilter">
                    To
                </label>

                <input id="toUtcFilter"
                       class="form-control"
                       type="datetime-local"
                       @bind="_toUtc" />
            </div>

            <div class="col-md-1 d-flex align-items-end">
                <button class="btn btn-primary w-100"
                        disabled="@_loading"
                        @onclick="LoadAsync">
                    Search
                </button>
            </div>
        </div>

        <div class="d-flex align-items-center gap-3 mt-3">
            <button class="btn btn-outline-secondary"
                    disabled="@_loading"
                    @onclick="ClearFiltersAsync">
                Clear filters
            </button>

            <small class="text-muted">
                Date filters use your local timezone.
            </small>
        </div>
    </div>
</div>

<ErrorBanner Message="@_error" />

@if (_loading)
{
    <LoadingSpinner Text="Loading audit entries..." />
}
else if (_items.Count == 0)
{
    <EmptyState Title="No audit entries"
                Message="No operations match the current filters." />
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Entity ID</th>
                    <th>Performed by</th>
                    <th>Details</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in _items)
                {
                    <tr>
                        <td class="text-nowrap">
                            @(item.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss"))
                        </td>

                        <td>
                            <span class="badge @GetActionBadge(item.Action)">
                                @item.Action
                            </span>
                        </td>

                        <td>@item.EntityName</td>
                        <td>@DisplayOrDash(item.EntityId)</td>
                        <td>@DisplayOrDash(item.PerformedBy)</td>

                        <td>
                            @if (string.IsNullOrWhiteSpace(item.Details))
                            {
                                <span class="text-muted">-</span>
                            }
                            else
                            {
                                var details = FormatDetails(item.Details);

                                <div class="fw-medium lh-sm">
                                    @details.Identity
                                </div>

                                @if (!string.IsNullOrWhiteSpace(details.Action))
                                {
                                    <div class="small text-body-secondary mt-1 lh-sm">
                                        @details.Action
                                    </div>
                                }

                                <details class="mt-1">
                                    <summary class="small text-muted">
                                        Raw details
                                    </summary>

                                    <code class="small text-break">
                                        @item.Details
                                    </code>
                                </details>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<AuditLogListItemDto> _items = [];
    private bool _loading;
    private string? _error;

    private string? _action;
    private string? _entityName;
    private string? _performedBy;
    private DateTime? _fromUtc;
    private DateTime? _toUtc;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var url = BuildUrl();
            var client =
                HttpClientFactory.CreateClient("AuthorizedApi");

            var result =
                await client.GetFromJsonAsync<
                    List<AuditLogListItemDto>>(url);

            _items = result ?? [];
        }
        catch
        {
            _error = "Failed to load audit entries.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ClearFiltersAsync()
    {
        _action = null;
        _entityName = null;
        _performedBy = null;
        _fromUtc = null;
        _toUtc = null;

        await LoadAsync();
    }

    private string BuildUrl()
    {
        var query = new List<string>();

        if (!string.IsNullOrWhiteSpace(_action))
        {
            query.Add(
                $"action={Uri.EscapeDataString(_action)}");
        }

        if (!string.IsNullOrWhiteSpace(_entityName))
        {
            query.Add(
                $"entityName={Uri.EscapeDataString(_entityName)}");
        }

        if (!string.IsNullOrWhiteSpace(_performedBy))
        {
            query.Add(
                $"performedBy={Uri.EscapeDataString(_performedBy)}");
        }

        if (_fromUtc.HasValue)
        {
            query.Add(
                $"fromUtc={Uri.EscapeDataString(
                    _fromUtc.Value
                        .ToUniversalTime()
                        .ToString("O"))}");
        }

        if (_toUtc.HasValue)
        {
            query.Add(
                $"toUtc={Uri.EscapeDataString(
                    _toUtc.Value
                        .ToUniversalTime()
                        .ToString("O"))}");
        }

        return query.Count == 0
            ? "api/audit"
            : $"api/audit?{string.Join("&", query)}";
    }

    private static FormattedAuditDetails FormatDetails(string details)
    {
        try
        {
            using var document = JsonDocument.Parse(details);

            if (document.RootElement.ValueKind !=
                JsonValueKind.Object)
            {
                return new(details, null);
            }

            var root = document.RootElement;
            var identityParts = new List<string>();
            var actionParts = new List<string>();

            AddProperty(identityParts, root, "Number");
            AddQuotedProperty(identityParts, root, "Title");

            var previousAssignedTo =
                GetString(root, "PreviousAssignedToDisplayName");

            var assignedTo =
                GetString(root, "AssignedToDisplayName");

            if (!string.IsNullOrWhiteSpace(previousAssignedTo) &&
                !string.IsNullOrWhiteSpace(assignedTo))
            {
                actionParts.Add($"{previousAssignedTo} → {assignedTo}");
            }
            else if (!string.IsNullOrWhiteSpace(assignedTo))
            {
                actionParts.Add($"Assigned to {assignedTo}");
            }

            var previousStatus =
                GetString(root, "PreviousStatus");

            var newStatus =
                GetString(root, "NewStatus");

            if (!string.IsNullOrWhiteSpace(previousStatus) &&
                !string.IsNullOrWhiteSpace(newStatus) &&
                !string.Equals(
                    previousStatus,
                    newStatus,
                    StringComparison.Ordinal))
            {
                actionParts.Add($"{previousStatus} → {newStatus}");
            }

            var identity = identityParts.Count == 0
                ? details
                : string.Join(" · ", identityParts);

            return new(
                identity,
                actionParts.Count == 0
                    ? null
                    : string.Join(" · ", actionParts));
        }
        catch (JsonException)
        {
            return new(details, null);
        }
    }

    private sealed record FormattedAuditDetails(
        string Identity,
        string? Action);

    private static void AddProperty(
        List<string> parts,
        JsonElement root,
        string name)
    {
        var value = GetString(root, name);

        if (!string.IsNullOrWhiteSpace(value))
            parts.Add(value);
    }

    private static void AddQuotedProperty(
        List<string> parts,
        JsonElement root,
        string name)
    {
        var value = GetString(root, name);

        if (!string.IsNullOrWhiteSpace(value))
            parts.Add($"\"{value}\"");
    }

    private static string? GetString(
        JsonElement root,
        string name)
    {
        if (!root.TryGetProperty(name, out var property))
            return null;

        return property.ValueKind == JsonValueKind.String
            ? property.GetString()
            : property.ToString();
    }

    private static string DisplayOrDash(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "-"
            : value;
    }

    private static string GetActionBadge(string action)
    {
        return action switch
        {
            "Create" => "bg-success",
            "Update" => "bg-primary",
            "Assign" => "bg-primary",
            "Reassign" => "bg-primary",
            "Started" => "bg-info text-dark",
            "Resolved" => "bg-success",
            "Closed" => "bg-secondary",
            "Reopened" => "bg-warning text-dark",
            "Restore" => "bg-info text-dark",
            "SoftDelete" => "bg-danger",
            "Delete" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
