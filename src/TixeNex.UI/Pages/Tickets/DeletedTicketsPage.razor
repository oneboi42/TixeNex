@page "/tickets/deleted"
@attribute [Authorize(Roles = "Admin")]

@using TixeNex.Shared.Contracts.Tickets
@using TixeNex.UI.Services.Api
@using Microsoft.AspNetCore.Authorization

@inject ITicketApiClient TicketApi
@inject NavigationManager Navigation

<PageTitle>Deleted tickets</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">Deleted tickets</h3>
        <div class="text-muted">Tickets in the recycle bin</div>
    </div>

    <NavLink class="btn btn-outline-secondary" href="tickets">
        Back to ticket list
    </NavLink>
</div>

<ErrorBanner Message="@_error" />

@if (_loading)
{
    <LoadingSpinner Text="Loading deleted tickets..." />
}
else if (!_items.Any())
{
    <EmptyState Title="The recycle bin is empty"
                Message="There are no deleted tickets." />
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Number</th>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _items)
                {
                    <tr>
                        <td>@item.Number</td>
                        <td>@item.Title</td>
                        <td>
                            <StatusBadge Status="@item.Status" />
                        </td>
                        <td>
                            <PriorityBadge Priority="@item.Priority" />
                        </td>
                        <td>@item.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-success"
                                    disabled="@_restoreBusy"
                                    @onclick="() => RestoreAsync(item.Id)">
                                Restore
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<AppToast @bind-Visible="_toastVisible"
          Type="@_toastType"
          Title="@_toastTitle"
          Message="@_toastMessage" />


@code {

    private bool _toastVisible;
    private string _toastType = "success";
    private string _toastTitle = "";
    private string? _toastMessage;

    private void ShowToast(string type, string title, string? message = null)
    {
        _toastType = type;
        _toastTitle = title;
        _toastMessage = message;
        _toastVisible = true;
    }

    private List<TicketDto> _items = [];
    private bool _loading;
    private bool _restoreBusy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _items = (await TicketApi.GetDeletedAsync()).ToList();
        }
        catch
        {
            _error = "Failed to load deleted tickets.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RestoreAsync(int id)
    {
        _restoreBusy = true;
        _error = null;

        try
        {
            var response = await TicketApi.RestoreAsync(id);

            if (!response.IsSuccessStatusCode)
            {
                _error = "Failed to restore the ticket.";
                return;
            }

            ShowToast("success", "Ticket restored", "The ticket was returned to the main list.");
            
            await LoadAsync();
        }
        catch
        {
            _error = "An error occurred while restoring the ticket.";
        }
        finally
        {
            _restoreBusy = false;
        }
    }
}
