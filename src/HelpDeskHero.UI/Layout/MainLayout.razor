@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using HelpDeskHero.Shared.Contracts.Notifications
@using HelpDeskHero.UI.Services.Auth
@using HelpDeskHero.UI.Services.Realtime
@implements IDisposable

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NotificationRealtimeCoordinator NotificationRealtime
@inject TokenStore TokenStore
@inject NavigationManager Navigation

<div class="app-shell">
    <aside class="app-sidebar">
        <NavMenu />
    </aside>

    <div class="app-main">
        @if (_isDemoSession && !IsHomePage)
        {
            <div class="alert alert-warning rounded-0 border-start-0 border-end-0 mb-0 py-2 px-3">
                <strong>Public demo workspace</strong>
                <span class="mx-1">·</span>
                @_demoDisplayName
                <span class="mx-1">·</span>
                session window ends @FormatLocalTime(_demoExpiresAtUtc)
                <span class="mx-1">·</span>
                extends with activity
            </div>
        }

        <main class="app-content">
            @Body
        </main>
    </div>
</div>

<AppToast @bind-Visible="_toastVisible"
          Type="info"
          Title="New message received"
          Message="@_toastMessage"
          AutoHide="true"
          AutoHideDelayMilliseconds="5000"
          ToastVersion="_toastVersion" />

@code {
    private bool _toastVisible;
    private string? _toastMessage;
    private long _toastVersion;

    private bool _isDemoSession;
    private string _demoDisplayName = "Demo user";
    private DateTime? _demoExpiresAtUtc;
    private CancellationTokenSource? _demoExpiryCts;

    private bool IsHomePage =>
    string.IsNullOrWhiteSpace(
        Navigation.ToBaseRelativePath(Navigation.Uri)
            .TrimEnd('/'));

    protected override async Task OnInitializedAsync()
    {
        NotificationRealtime.NotificationReceived += ShowNotificationToastAsync;
        TokenStore.SessionChanged += OnStoredSessionChanged;
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

        var authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var userId = GetUserId(authenticationState.User);

        if (userId is not null)
        {
            await NotificationRealtime.TryStartAsync(userId);
        }

        await RefreshDemoBannerAsync();
    }

    private async Task RefreshDemoBannerAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var user = authenticationState.User;

        _isDemoSession =
            user.Identity?.IsAuthenticated == true &&
            string.Equals(
                user.FindFirst("is_demo")?.Value,
                "true",
                StringComparison.OrdinalIgnoreCase);

        if (!_isDemoSession)
        {
            _demoDisplayName = "Demo user";
            _demoExpiresAtUtc = null;
            CancelDemoExpiryTimer();
            return;
        }

        _demoDisplayName = GetDisplayName(user);
        _demoExpiresAtUtc = await TokenStore.GetDemoExpiresAtUtcAsync();

        ScheduleDemoExpiry(_demoExpiresAtUtc);
    }

    private void ScheduleDemoExpiry(DateTime? expiresAtUtc)
    {
        CancelDemoExpiryTimer();

        if (!expiresAtUtc.HasValue)
            return;

        var delay =
            expiresAtUtc.Value.ToUniversalTime() - DateTime.UtcNow;

        if (delay < TimeSpan.Zero)
            delay = TimeSpan.Zero;

        var cts = new CancellationTokenSource();
        _demoExpiryCts = cts;

        _ = WaitForDemoExpiryAsync(delay, cts);
    }

    private async Task WaitForDemoExpiryAsync(
        TimeSpan delay,
        CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(delay, cts.Token);

            await InvokeAsync(
                () => HandleDemoExpiryAsync(cts));
        }
        catch (OperationCanceledException)
        {
            // The session was refreshed, replaced, or cleared.
        }
    }

    private async Task HandleDemoExpiryAsync(
        CancellationTokenSource cts)
    {
        if (cts != _demoExpiryCts ||
            cts.IsCancellationRequested)
        {
            return;
        }

        var latestExpiry =
            await TokenStore.GetDemoExpiresAtUtcAsync();

        if (latestExpiry.HasValue &&
            latestExpiry.Value.ToUniversalTime() > DateTime.UtcNow)
        {
            _demoExpiresAtUtc = latestExpiry;

            ScheduleDemoExpiry(latestExpiry);

            StateHasChanged();
            return;
        }


        await TokenStore.ClearAsync();

        try
        {
            await NotificationRealtime.ResetAsync();
        }
        finally
        {
            if (AuthenticationStateProvider
                is JwtAuthenticationStateProvider jwtProvider)
            {
                jwtProvider.NotifyUserLogout();
            }
        }

        Navigation.NavigateTo("/login");
    }

    private void CancelDemoExpiryTimer()
    {
        var cts = _demoExpiryCts;
        _demoExpiryCts = null;

        if (cts is null)
            return;

        cts.Cancel();
        cts.Dispose();
    }

    private void OnStoredSessionChanged()
    {
        QueueDemoBannerRefresh();
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> _)
    {
        QueueDemoBannerRefresh();
    }

    private void QueueDemoBannerRefresh()
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshDemoBannerAsync();
            StateHasChanged();
        });
    }

    private static string GetDisplayName(ClaimsPrincipal user)
    {
        return user.FindFirst("display_name")?.Value
            ?? user.Identity?.Name
            ?? user.FindFirst("name")?.Value
            ?? user.FindFirst(ClaimTypes.Name)?.Value
            ?? user.FindFirst("unique_name")?.Value
            ?? user.FindFirst("sub")?.Value
            ?? "User";
    }

    private static string? GetUserId(ClaimsPrincipal user)
    {
        if (user.Identity?.IsAuthenticated != true)
            return null;

        return user.FindFirst(ClaimTypes.NameIdentifier)?.Value
            ?? user.FindFirst("sub")?.Value;
    }

    private static string FormatLocalTime(DateTime? value) =>
    value.HasValue
        ? value.Value.ToLocalTime().ToString("HH:mm")
        : "soon";

    private async Task ShowNotificationToastAsync(UserNotificationDto notification)
    {
        _toastMessage = notification.Subject;
        _toastVisible = true;
        _toastVersion++;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CancelDemoExpiryTimer();

        NotificationRealtime.NotificationReceived -= ShowNotificationToastAsync;
        TokenStore.SessionChanged -= OnStoredSessionChanged;
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
