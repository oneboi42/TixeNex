@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using HelpDeskHero.Shared.Contracts.Notifications
@using HelpDeskHero.UI.Services.Auth
@using HelpDeskHero.UI.Services.Realtime
@implements IDisposable

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NotificationRealtimeCoordinator NotificationRealtime
@inject TokenStore TokenStore

<div class="app-shell">
    <aside class="app-sidebar">
        <NavMenu />
    </aside>

    <div class="app-main">
        <header class="app-topbar">
            <div>
                <div class="app-title">HelpDeskHero</div>
                <div class="app-subtitle">Ticket support dashboard</div>
            </div>

            <AuthorizeView Context="topbarAuth">
                <Authorized>
                    <div class="user-panel">
                        <div class="user-info">
                            <div class="user-name">
                                @GetDisplayName(topbarAuth.User)
                            </div>

                            <div class="user-role">
                                @GetRole(topbarAuth.User)
                            </div>
                        </div>

                        <NavLink class="btn btn-outline-danger btn-sm" href="logout">
                            Sign out
                        </NavLink>
                    </div>
                </Authorized>

                <NotAuthorized>
                    <NavLink class="btn btn-outline-primary btn-sm" href="login">
                        Sign in
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </header>

        @if (_isDemoSession)
        {
            <div class="alert alert-warning rounded-0 border-start-0 border-end-0 mb-0 py-2 px-3">
                <strong>Public demo workspace</strong>
                <span class="mx-1">·</span>
                @_demoDisplayName
                <span class="mx-1">·</span>
                session window ends @FormatUtc(_demoExpiresAtUtc)
                <span class="mx-1">·</span>
                shared demo data
            </div>
        }

        <main class="app-content">
            @Body
        </main>
    </div>
</div>

<AppToast @bind-Visible="_toastVisible"
          Type="info"
          Title="New message received"
          Message="@_toastMessage"
          AutoHide="true"
          AutoHideDelayMilliseconds="5000"
          ToastVersion="_toastVersion" />

@code {
    private bool _toastVisible;
    private string? _toastMessage;
    private long _toastVersion;

    private bool _isDemoSession;
    private string _demoDisplayName = "Demo user";
    private DateTime? _demoExpiresAtUtc;

    protected override async Task OnInitializedAsync()
    {
        NotificationRealtime.NotificationReceived += ShowNotificationToastAsync;
        TokenStore.SessionChanged += OnStoredSessionChanged;
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

        var authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var userId = GetUserId(authenticationState.User);

        if (userId is not null)
        {
            await NotificationRealtime.TryStartAsync(userId);
        }

        await RefreshDemoBannerAsync();
    }

    private async Task RefreshDemoBannerAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var user = authenticationState.User;

        _isDemoSession =
            user.Identity?.IsAuthenticated == true &&
            string.Equals(
                user.FindFirst("is_demo")?.Value,
                "true",
                StringComparison.OrdinalIgnoreCase);

        if (!_isDemoSession)
        {
            _demoDisplayName = "Demo user";
            _demoExpiresAtUtc = null;
            return;
        }

        _demoDisplayName = GetDisplayName(user);
        _demoExpiresAtUtc = await TokenStore.GetDemoExpiresAtUtcAsync();
    }

    private void OnStoredSessionChanged()
    {
        QueueDemoBannerRefresh();
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> _)
    {
        QueueDemoBannerRefresh();
    }

    private void QueueDemoBannerRefresh()
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshDemoBannerAsync();
            StateHasChanged();
        });
    }

    private static string GetDisplayName(ClaimsPrincipal user)
    {
        return user.FindFirst("display_name")?.Value
            ?? user.Identity?.Name
            ?? user.FindFirst("name")?.Value
            ?? user.FindFirst(ClaimTypes.Name)?.Value
            ?? user.FindFirst("unique_name")?.Value
            ?? user.FindFirst("sub")?.Value
            ?? "User";
    }

    private static string GetRole(ClaimsPrincipal user)
    {
        if (user.IsInRole("Admin"))
            return "Admin";

        if (user.IsInRole("Agent"))
            return "Agent";

        if (user.IsInRole("User"))
            return "User";

        return user.FindFirst(ClaimTypes.Role)?.Value
            ?? user.FindFirst("role")?.Value
            ?? user.FindFirst("roles")?.Value
            ?? "No role";
    }

    private static string? GetUserId(ClaimsPrincipal user)
    {
        if (user.Identity?.IsAuthenticated != true)
            return null;

        return user.FindFirst(ClaimTypes.NameIdentifier)?.Value
            ?? user.FindFirst("sub")?.Value;
    }

    private static string FormatUtc(DateTime? value) =>
        value.HasValue
            ? $"{value.Value.ToUniversalTime():HH:mm} UTC"
            : "soon";

    private async Task ShowNotificationToastAsync(UserNotificationDto notification)
    {
        _toastMessage = notification.Subject;
        _toastVisible = true;
        _toastVersion++;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NotificationRealtime.NotificationReceived -= ShowNotificationToastAsync;
        TokenStore.SessionChanged -= OnStoredSessionChanged;
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
