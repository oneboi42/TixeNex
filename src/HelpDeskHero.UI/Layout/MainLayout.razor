@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="topbar d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
            <h5 class="m-0">HelpDeskHero</h5>

            <AuthorizeView>
                <Authorized>
                    <div>
                        <span class="me-2">
                            @context.User.Identity?.Name
                        </span>

                        @if (context.User.IsInRole("Admin"))
                        {
                            <span class="badge bg-primary me-2">Admin</span>
                        }
                        else if (context.User.IsInRole("Agent"))
                        {
                            <span class="badge bg-info text-dark me-2">Agent</span>
                        }
                        else if (context.User.IsInRole("User"))
                        {
                            <span class="badge bg-secondary me-2">User</span>
                        }
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <div class="content px-4 py-3">
            @Body
        </div>
    </main>
</div>