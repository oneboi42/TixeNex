@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@using HelpDeskHero.UI.Services.Api

@inject NotificationApiClient NotificationApi

<div class="sidebar-header">
    <a class="sidebar-brand" href="">
        HelpDeskHero
    </a>
</div>

<nav class="sidebar-nav">
    <div class="nav-section-title">Menu</div>

    <div class="nav-item">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            Home
        </NavLink>
    </div>

    <AuthorizeView Context="mainAuth">
        <Authorized>
            <div class="nav-item">
                <NavLink class="nav-link" href="tickets">
                    Tickets
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="dashboard">
                    Dashboard
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link d-flex justify-content-between align-items-center" href="notifications">
                    <span>Notifications</span>
                    @if (_unreadCount > 0)
                    {
                        <span class="badge bg-primary">@_unreadCount</span>
                    }
                </NavLink>
            </div>

            <AuthorizeView Roles="Admin,Agent" Context="createAuth">
                <Authorized>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="tickets/create">
                            Nowe zgłoszenie
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Admin" Context="adminAuth">
                <Authorized>
                    <div class="nav-section-title">Administracja</div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="admin">
                            Admin
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="admin/audit">
                            Audit Log
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="tickets/deleted">
                            Deleted tickets
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>

            <div class="nav-section-title">Konto</div>

            <div class="nav-item">
                <NavLink class="nav-link" href="account/settings">
                    Ustawienia konta
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="logout">
                    Wyloguj
                </NavLink>
            </div>
        </Authorized>

        <NotAuthorized>
            <div class="nav-item">
                <NavLink class="nav-link" href="login">
                    Zaloguj
                </NavLink>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    private int _unreadCount;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var notifications = await NotificationApi.GetMineAsync();
            _unreadCount = notifications.Count(x => !x.IsRead);
        }
        catch
        {
            _unreadCount = 0;
        }
    }
}
