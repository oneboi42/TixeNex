@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization

<div class="sidebar-header">
    <a class="sidebar-brand" href="">
        HelpDeskHero
    </a>
</div>

<nav class="sidebar-nav">
    <div class="nav-section-title">Menu</div>

    <div class="nav-item">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            Home
        </NavLink>
    </div>

    <AuthorizeView Context="mainAuth">
        <Authorized>
            <div class="nav-item">
                <NavLink class="nav-link" href="tickets">
                    Tickets
                </NavLink>
            </div>

            <AuthorizeView Roles="Admin,Agent" Context="createAuth">
                <Authorized>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="tickets/create">
                            Nowe zgłoszenie
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Admin" Context="adminAuth">
                <Authorized>
                    <div class="nav-section-title">Administracja</div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="admin">
                            Admin
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="admin/audit">
                            Audit Log
                        </NavLink>
                    </div>
                    <div class="nav-item">
                    <NavLink class="nav-link" href="tickets/deleted">
                        Kosz
                    </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>

            <div class="nav-section-title">Konto</div>

            <div class="nav-item">
                <NavLink class="nav-link" href="account/settings">
                    Ustawienia konta
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="logout">
                    Wyloguj
                </NavLink>
            </div>
        </Authorized>

        <NotAuthorized>
            <div class="nav-item">
                <NavLink class="nav-link" href="login">
                    Zaloguj
                </NavLink>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</nav>