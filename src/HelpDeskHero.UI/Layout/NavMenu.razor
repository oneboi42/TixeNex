@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@using HelpDeskHero.UI.Services.Api
@implements IDisposable

@inject NotificationApiClient NotificationApi

<div class="sidebar-header">
    <a class="sidebar-brand" href="">
        HelpDeskHero
    </a>
</div>

<nav class="sidebar-nav">
    <div class="nav-section-title">Menu</div>

    <div class="nav-item">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            Home
        </NavLink>
    </div>

    <AuthorizeView Context="mainAuth">
        <Authorized>
            <div class="nav-item">
                <NavLink class="nav-link" href="tickets">
                    Tickets
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="exports">
                    Exports
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="dashboard">
                    Dashboard
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link d-flex justify-content-between align-items-center" href="notifications">
                    <span>Notifications</span>
                    @if (_unreadCount > 0)
                    {
                        <span class="badge bg-primary">@_unreadCount</span>
                    }
                </NavLink>
            </div>

            <AuthorizeView Roles="Admin,Agent" Context="createAuth">
                <Authorized>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="tickets/create">
                            New Ticket
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Admin" Context="adminAuth">
                <Authorized>
                    <div class="nav-section-title">Administration</div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="admin">
                            Admin
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="admin/audit">
                            Audit Log
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="tickets/deleted">
                            Deleted tickets
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>

            <div class="nav-section-title">Account</div>

            <div class="nav-item">
                <NavLink class="nav-link" href="account/settings">
                    Account Settings
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="logout">
                    Logout
                </NavLink>
            </div>
        </Authorized>

        <NotAuthorized>
            <div class="nav-item">
                <NavLink class="nav-link" href="login">
                    Login
                </NavLink>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    private int _unreadCount;

    protected override void OnInitialized()
    {
        NotificationApi.UnreadCountChanged += OnUnreadCountChanged;
        _unreadCount = NotificationApi.CurrentUnreadCount;
    }

    private void OnUnreadCountChanged(int unreadCount)
    {
        _unreadCount = unreadCount;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NotificationApi.UnreadCountChanged -= OnUnreadCountChanged;
    }
}
