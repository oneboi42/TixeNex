@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">HelpDeskHero</a>
    </div>
</div>

<div class="nav-scrollable">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                Home
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="tickets">
                        Tickets
                    </NavLink>
                </div>

                <AuthorizeView Roles="Agent,Admin" Context="innerContext">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="tickets/create">
                            New ticket
                        </NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Roles="Admin" Context="innerContext">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin">
                            Admin
                        </NavLink>
                    </div>
                </AuthorizeView>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="logout">
                        Logout
                    </NavLink>
                </div>
            </Authorized>
            
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>