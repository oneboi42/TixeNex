@page "/login"
@attribute [AllowAnonymous]

@using System.ComponentModel.DataAnnotations
@using System.IdentityModel.Tokens.Jwt
@using HelpDeskHero.Shared.Contracts.Auth
@using HelpDeskHero.UI.Services.Api
@using HelpDeskHero.UI.Services.Auth
@using Microsoft.AspNetCore.Authorization

@inject AuthApiClient AuthApi
@inject TokenStore TokenStore
@inject JwtAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<h3>Logowanie</h3>

<EditForm Model="_model" OnValidSubmit="HandleLoginAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Login</label>
        <InputText class="form-control" @bind-Value="_model.UserName" />
        <ValidationMessage For="@(() => _model.UserName)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Hasło</label>
        <InputText class="form-control" type="password" @bind-Value="_model.Password" />
        <ValidationMessage For="@(() => _model.Password)" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    <button class="btn btn-primary" type="submit" disabled="@_busy">
        @(_busy ? "Logowanie..." : "Zaloguj")
    </button>
</EditForm>

@code {
    private bool _busy;
    private string? _error;
    private LoginVm _model = new();

    private async Task HandleLoginAsync()
    {
        if (_busy) return;

        _busy = true;
        _error = null;

        try
        {
            var result = await AuthApi.LoginAsync(new LoginRequestDto
            {
                UserName = _model.UserName,
                Password = _model.Password
            });

            if (result is null)
            {
                _error = "Niepoprawny login lub hasło.";
                return;
            }

            await TokenStore.SetAccessTokenAsync(result.AccessToken);
            await TokenStore.SetRefreshTokenAsync(result.RefreshToken);

            var handler = new JwtSecurityTokenHandler();
            var jwt = handler.ReadJwtToken(result.AccessToken);

            AuthStateProvider.NotifyUserAuthentication(jwt.Claims);

            Navigation.NavigateTo("/tickets");
        }
        catch (Exception ex)
        {
            _error = $"Błąd logowania: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class LoginVm
    {
        [Required]
        public string UserName { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}