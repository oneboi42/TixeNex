@page "/"

@using System.Security.Claims
@using HelpDeskHero.UI.Services.Auth
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject TokenStore TokenStore
@inject NavigationManager Nav

<PageTitle>Home</PageTitle>

<AuthorizeView Context="homeAuth">
    <Authorized>
        @if (IsDemoUser(homeAuth.User))
        {
            <div class="mb-4">
                <h1>Public Demo Workspace</h1>
                <p class="lead mb-1">
                    You are signed in as <strong>@GetDisplayName(homeAuth.User)</strong>.
                </p>
                <p class="text-muted mb-0">
                    Role: <strong>@GetRole(homeAuth.User)</strong>
                </p>
            </div>

            <div class="alert alert-warning">
                <strong>This is a shared demo environment.</strong>
                Other demo visitors can create and modify demo tickets at the same time.
                You may therefore see changes that were not made by your account.
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">Current demo session</h5>
                            <dl class="row mb-0">
                                <dt class="col-sm-5">Account</dt>
                                <dd class="col-sm-7">@GetDisplayName(homeAuth.User)</dd>

                                <dt class="col-sm-5">Role</dt>
                                <dd class="col-sm-7">@GetRole(homeAuth.User)</dd>

                                <dt class="col-sm-5">Current session ends</dt>
                                <dd class="col-sm-7">@FormatLocalDateTime(_demoExpiresAtUtc)</dd>

                                <dt class="col-sm-5">Maximum session limit</dt>
                                <dd class="col-sm-7">@FormatLocalDateTime(_demoAbsoluteExpiresAtUtc)</dd>
                            </dl>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">How the demo works</h5>
                            <ul class="mb-0">
                                <li>Your account is temporary and uniquely identifies your actions.</li>
                                <li>Your session can be extended while you actively use the application.</li>
                                <li>The session can never continue beyond the absolute demo limit.</li>
                                <li>Temporary demo tickets are removed automatically.</li>
                                <li>Demo and normal production-style data are kept in separate workspaces.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/tickets")'>
                    View tickets
                </button>

                <button class="btn btn-outline-primary" @onclick='() => Nav.NavigateTo("/tickets/create")'>
                    Create a ticket
                </button>

                @if (homeAuth.User.IsInRole("Admin"))
                {
                    <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/admin")'>
                        Open administration
                    </button>
                }
            </div>
        }
        else
        {
            <h1>HelpDeskHero</h1>
            <p class="lead">
                Ticket support dashboard.
            </p>

            <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/tickets")'>
                Open tickets
            </button>
        }
    </Authorized>

    <NotAuthorized>
        <h1>HelpDeskHero</h1>
        <p class="lead">
            Sign in with an existing account or start a temporary public demo.
        </p>

        <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/login")'>
            Sign in / Start demo
        </button>
    </NotAuthorized>
</AuthorizeView>

@code {
    private DateTime? _demoExpiresAtUtc;
    private DateTime? _demoAbsoluteExpiresAtUtc;

    protected override async Task OnInitializedAsync()
    {
        TokenStore.SessionChanged += OnSessionChanged;
        await LoadDemoSessionAsync();
    }

    private async Task LoadDemoSessionAsync()
    {
        _demoExpiresAtUtc = await TokenStore.GetDemoExpiresAtUtcAsync();
        _demoAbsoluteExpiresAtUtc = await TokenStore.GetDemoAbsoluteExpiresAtUtcAsync();
    }

    private void OnSessionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadDemoSessionAsync();
            StateHasChanged();
        });
    }

    private static bool IsDemoUser(ClaimsPrincipal user) =>
        string.Equals(
            user.FindFirst("is_demo")?.Value,
            "true",
            StringComparison.OrdinalIgnoreCase);

    private static string GetDisplayName(ClaimsPrincipal user) =>
        user.FindFirst("display_name")?.Value
        ?? user.Identity?.Name
        ?? user.FindFirst(ClaimTypes.Name)?.Value
        ?? user.FindFirst("unique_name")?.Value
        ?? "User";

    private static string GetRole(ClaimsPrincipal user)
    {
        if (user.IsInRole("Admin"))
            return "Admin";

        if (user.IsInRole("Agent"))
            return "Agent";

        if (user.IsInRole("User"))
            return "User";

        return "No role";
    }

    private static string FormatLocalDateTime(DateTime? value) =>
    value.HasValue
        ? value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
        : "—";

    public void Dispose()
    {
        TokenStore.SessionChanged -= OnSessionChanged;
    }
}
