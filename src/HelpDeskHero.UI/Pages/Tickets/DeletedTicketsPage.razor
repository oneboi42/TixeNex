@page "/tickets/deleted"
@attribute [Authorize(Policy = "CanManageTickets")]

@using HelpDeskHero.Shared.Contracts.Tickets
@using HelpDeskHero.UI.Services.Api
@using Microsoft.AspNetCore.Authorization

@inject ITicketApiClient TicketApi
@inject NavigationManager Navigation

<PageTitle>Usunięte zgłoszenia</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">Usunięte zgłoszenia</h3>
        <div class="text-muted">Lista zgłoszeń usuniętych przez soft delete</div>
    </div>

    <NavLink class="btn btn-outline-secondary" href="tickets">
        Powrót do listy
    </NavLink>
</div>

<ErrorBanner Message="@_error" />

@if (_loading)
{
    <LoadingSpinner Text="Ładowanie usuniętych zgłoszeń..." />
}
else if (!_items.Any())
{
    <EmptyState Title="Kosz jest pusty"
                Message="Nie ma żadnych usuniętych zgłoszeń." />
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Nr</th>
                    <th>Tytuł</th>
                    <th>Status</th>
                    <th>Priorytet</th>
                    <th>Utworzono</th>
                    <th class="text-end">Akcje</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _items)
                {
                    <tr>
                        <td>@item.Number</td>
                        <td>@item.Title</td>
                        <td>
                            <StatusBadge Status="@item.Status" />
                        </td>
                        <td>
                            <PriorityBadge Priority="@item.Priority" />
                        </td>
                        <td>@item.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-success"
                                    disabled="@_restoreBusy"
                                    @onclick="() => RestoreAsync(item.Id)">
                                Restore
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<AppToast @bind-Visible="_toastVisible"
          Type="@_toastType"
          Title="@_toastTitle"
          Message="@_toastMessage" />


@code {

    private bool _toastVisible;
    private string _toastType = "success";
    private string _toastTitle = "";
    private string? _toastMessage;

    private void ShowToast(string type, string title, string? message = null)
    {
        _toastType = type;
        _toastTitle = title;
        _toastMessage = message;
        _toastVisible = true;
    }

    private List<TicketDto> _items = [];
    private bool _loading;
    private bool _restoreBusy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _items = (await TicketApi.GetDeletedAsync()).ToList();
        }
        catch
        {
            _error = "Nie udało się pobrać usuniętych zgłoszeń.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RestoreAsync(int id)
    {
        _restoreBusy = true;
        _error = null;

        try
        {
            var response = await TicketApi.RestoreAsync(id);

            if (!response.IsSuccessStatusCode)
            {
                _error = "Nie udało się przywrócić zgłoszenia.";
                return;
            }

            ShowToast("success", "Przywrócono zgłoszenie", "Zgłoszenie wróciło na główną listę.");
            
            await LoadAsync();
        }
        catch
        {
            _error = "Wystąpił błąd podczas przywracania zgłoszenia.";
        }
        finally
        {
            _restoreBusy = false;
        }
    }
}
