@page "/tickets/{Id:int}"
@attribute [Authorize]
@using HelpDeskHero.Shared.Contracts.Tickets
@inject HelpDeskHero.UI.Services.Api.TicketApiClient TicketApi
@inject NavigationManager Nav

<h3>Szczegóły zgłoszenia</h3>

@if (_ticket is null)
{
    <Loading Visible="true" />
}
else
{
    <div class="card">
        <div class="card-body">
            <p><strong>Numer:</strong> @_ticket.Number</p>
            <p><strong>Tytuł:</strong> @_ticket.Title</p>
            <p><strong>Status:</strong> <StatusBadge Status="@_ticket.Status" /></p>
            <p><strong>Priorytet:</strong> <PriorityBadge Priority="@_ticket.Priority" /></p>
            <p><strong>Opis:</strong> @_ticket.Description</p>

            <button class="btn btn-primary"
                    @onclick='() => Nav.NavigateTo($"/tickets/edit/{Id}")'>
                Edytuj
            </button>

            <button class="btn btn-secondary"
                    @onclick='() => Nav.NavigateTo("/tickets")'>
                Powrót
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private TicketDetailsDto? _ticket;

    protected override async Task OnParametersSetAsync()
    {
        _ticket = await TicketApi.GetByIdAsync(Id);
    }
}