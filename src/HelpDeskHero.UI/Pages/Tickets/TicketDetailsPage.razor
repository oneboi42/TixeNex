@page "/tickets/{Id:int}"
@attribute [Authorize]

@using HelpDeskHero.Shared.Contracts.Tickets
@using HelpDeskHero.UI.Services.Api
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject HelpDeskHero.UI.Services.Api.ITicketApiClient TicketApi
@inject NavigationManager Nav

<PageTitle>Ticket details</PageTitle>

<h3>Details</h3>

<ErrorBanner Message="@_error" />

@if (_loading)
{
    <LoadingSpinner Text="Loading ticket..." />
}
else if (_ticket is not null)
{
    <div class="card">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Number</dt>
                <dd class="col-sm-9">@_ticket.Number</dd>

                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9">@_ticket.Title</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    <StatusBadge Status="@_ticket.Status" />
                </dd>

                <dt class="col-sm-3">Priority</dt>
                <dd class="col-sm-9">
                    <PriorityBadge Priority="@_ticket.Priority" />
                </dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@_ticket.Description</dd>
            </dl>

            <div class="d-flex gap-2 mt-3">
                <AuthorizeView Roles="Admin,Agent">
                    <Authorized>
                        @foreach (var action in GetLifecycleActions(_ticket.Status))
                        {
                            <button class="btn btn-success"
                                    disabled="@_lifecycleBusy"
                                    @onclick="() => ChangeStatusAsync(action.TargetStatus)">
                                @(_lifecycleBusy ? "Saving..." : action.Label)
                            </button>
                        }

                        <button class="btn btn-primary"
                                disabled="@_lifecycleBusy"
                                @onclick='() => Nav.NavigateTo($"/tickets/edit/{Id}")'>
                            Edit
                        </button>
                    </Authorized>
                </AuthorizeView>

                <button class="btn btn-secondary"
                        @onclick='() => Nav.NavigateTo("/tickets")'>
                    Back
                </button>
            </div>

            <AppToast @bind-Visible="_toastVisible"
                      Type="success"
                      Title="Ticket updated"
                      Message="@_toastMessage"
                      AutoHide="true"
                      ToastVersion="@_toastVersion" />
        </div>
    </div>

    <TicketAttachments TicketId="Id" />

    <TicketComments TicketId="Id" />
}

@code {
    [Parameter]
    public int Id { get; set; }

    private TicketDto? _ticket;
    private string? _error;
    private bool _loading;
    private bool _lifecycleBusy;
    private bool _toastVisible;
    private string? _toastMessage;
    private long _toastVersion;

    protected override Task OnParametersSetAsync() => LoadTicketAsync();

    private async Task ChangeStatusAsync(string targetStatus)
    {
        if (_ticket is null || _lifecycleBusy)
            return;

        _lifecycleBusy = true;
        _error = null;

        try
        {
            var response = await TicketApi.UpdateAsync(Id, new UpdateTicketDto
            {
                Title = _ticket.Title,
                Description = _ticket.Description,
                Priority = _ticket.Priority,
                Status = targetStatus,
                RowVersionBase64 = _ticket.RowVersionBase64
            });

            if (response.IsSuccessStatusCode)
            {
                await LoadTicketAsync();
                _toastMessage = $"Ticket status changed to {targetStatus}.";
                _toastVersion++;
                _toastVisible = true;
                return;
            }

            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                await LoadTicketAsync();
                _error = "This ticket was modified by another user. The latest version has been loaded.";
                return;
            }

            _error = await ApiErrorMapper.ToMessageAsync(response, "Could not update the ticket status.");
        }
        catch
        {
            _error = "Could not update the ticket status.";
        }
        finally
        {
            _lifecycleBusy = false;
        }
    }

    private static IReadOnlyList<LifecycleAction> GetLifecycleActions(string status) => status switch
    {
        "New" => [new("Start work", "InProgress")],
        "InProgress" => [new("Resolve", "Resolved")],
        "Resolved" => [new("Close", "Closed"), new("Reopen", "InProgress")],
        _ => []
    };

    private sealed record LifecycleAction(string Label, string TargetStatus);

    private async Task LoadTicketAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _ticket = await TicketApi.GetByIdAsync(Id);

            if (_ticket is null)
                _error = "Ticket was not found.";
        }
        catch
        {
            _error = "Could not load ticket details.";
        }
        finally
        {
            _loading = false;
        }
    }
}
