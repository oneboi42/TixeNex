@page "/tickets/{Id:int}"
@attribute [Authorize]

@using HelpDeskHero.Shared.Contracts.Tickets
@using HelpDeskHero.Shared.Contracts.Users
@using HelpDeskHero.UI.Services.Api
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject ITicketApiClient TicketApi
@inject UserApiClient UserApi
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav

<PageTitle>Ticket details</PageTitle>

<h3>Details</h3>

<ErrorBanner Message="@_error" />

@if (_loading)
{
    <LoadingSpinner Text="Loading ticket..." />
}
else if (_ticket is not null)
{
    <div class="card">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Number</dt>
                <dd class="col-sm-9">@_ticket.Number</dd>

                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9">@_ticket.Title</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    <StatusBadge Status="@_ticket.Status" />
                </dd>

                <dt class="col-sm-3">Priority</dt>
                <dd class="col-sm-9">
                    <PriorityBadge Priority="@_ticket.Priority" />
                </dd>

                @if (_isAdmin || _ticket.IsDemoTicket)
                {
                    <dt class="col-sm-3">Requester</dt>
                    <dd class="col-sm-9">
                        @(_ticket.RequesterDisplayName ?? "Unknown")
                        @if (_ticket.IsRequesterCurrentUser)
                        {
                            <span class="text-muted">(you)</span>
                        }
                    </dd>
                }

                @if (_ticket.IsDemoTicket)
                {
                    <dt class="col-sm-3">Demo data expires</dt>
                    <dd class="col-sm-9">@FormatUtc(_ticket.DemoExpiresAtUtc)</dd>
                }
                
                <dt class="col-sm-3">Assigned to</dt>
                <dd class="col-sm-9">@(_ticket.AssignedToDisplayName ?? "Unassigned")</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@_ticket.Description</dd>
            </dl>

            @if (_isAdmin)
            {
                <hr />

                <h5>Assignment</h5>

                @if (_ticket.Status == "Closed")
                {
                    <div class="alert alert-info mb-3">
                        Closed tickets cannot be reassigned.
                    </div>
                }
                else if (_agentsLoading)
                {
                    <LoadingSpinner Text="Loading agents..." />
                }
                else if (_agents.Count == 0)
                {
                    <div class="alert alert-warning mb-3">
                        No active agents are available.
                    </div>
                }
                else
                {
                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-md-8">
                            <label for="assigned-agent" class="form-label">
                                Agent
                            </label>

                            <select id="assigned-agent"
                                    class="form-select"
                                    @bind="_selectedAgentId"
                                    disabled="@_assignmentBusy">
                                <option value="">Select an agent</option>

                                @foreach (var agent in _agents)
                                {
                                    <option value="@agent.Id">
                                        @FormatAgent(agent)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <button class="btn btn-primary w-100"
                                    disabled="@IsAssignmentButtonDisabled"
                                    @onclick="AssignAsync">
                                @AssignmentButtonText
                            </button>
                        </div>
                    </div>
                }
            }

            <div class="d-flex gap-2 mt-3">
                @foreach (var action in GetLifecycleActions(_ticket))
                {
                    <button class="btn btn-success"
                            disabled="@(_lifecycleBusy || _assignmentBusy)"
                            @onclick="() => ChangeStatusAsync(action)">
                        @(_lifecycleBusy ? "Saving..." : action.Label)
                    </button>
                }

                @if (_ticket.CanEdit)
                {
                    <button class="btn btn-primary"
                            disabled="@(_lifecycleBusy || _assignmentBusy)"
                            @onclick='() => Nav.NavigateTo($"/tickets/edit/{Id}")'>
                        Edit
                    </button>
                }

                <button class="btn btn-secondary"
                        disabled="@(_lifecycleBusy || _assignmentBusy)"
                        @onclick='() => Nav.NavigateTo("/tickets")'>
                    Back
                </button>
            </div>

            <AppToast @bind-Visible="_toastVisible"
                      Type="success"
                      Title="Ticket updated"
                      Message="@_toastMessage"
                      AutoHide="true"
                      ToastVersion="@_toastVersion" />
        </div>
    </div>

    <TicketAttachments TicketId="Id" />

    <TicketComments TicketId="Id" />
}

@code {
    [Parameter]
    public int Id { get; set; }

    private TicketDto? _ticket;
    private IReadOnlyList<AssignableAgentDto> _agents = [];
    private string _selectedAgentId = string.Empty;
    private string? _error;
    private bool _loading;
    private bool _agentsLoading;
    private bool _lifecycleBusy;
    private bool _assignmentBusy;
    private bool _isAdmin;
    private bool _toastVisible;
    private string? _toastMessage;
    private long _toastVersion;

    private bool IsAssignmentButtonDisabled =>
        _assignmentBusy ||
        string.IsNullOrWhiteSpace(_selectedAgentId) ||
        _selectedAgentId == _ticket?.AssignedToUserId;

    private string AssignmentButtonText =>
        _assignmentBusy
            ? "Saving..."
            : _ticket?.AssignedToUserId is null
                ? "Assign"
                : "Reassign";

    protected override async Task OnParametersSetAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        _isAdmin = authenticationState.User.IsInRole("Admin");

        await LoadTicketAsync();

        if (_isAdmin && _ticket is not null)
            await LoadAgentsAsync();
    }

    private async Task AssignAsync()
    {
        if (_ticket is null ||
            _assignmentBusy ||
            string.IsNullOrWhiteSpace(_selectedAgentId))
        {
            return;
        }

        _assignmentBusy = true;
        _error = null;

        try
        {
            var request = new AssignTicketDto
            {
                AssignedToUserId = _selectedAgentId,
                RowVersionBase64 = _ticket.RowVersionBase64
            };

            var response = await TicketApi.AssignAsync(Id, request);

            if (response.IsSuccessStatusCode)
            {
                var wasReassignment = _ticket.AssignedToUserId is not null;
                await LoadTicketAsync();
                _selectedAgentId = _ticket?.AssignedToUserId ?? string.Empty;
                _toastMessage = wasReassignment
                    ? "Ticket was reassigned and moved to New."
                    : "Ticket was assigned and moved to New.";
                _toastVersion++;
                _toastVisible = true;
                return;
            }

            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                var code = await ApiErrorMapper.GetProblemCodeAsync(response);

                if (code == "concurrency_conflict")
                {
                    await LoadTicketAsync();
                    _selectedAgentId = _ticket?.AssignedToUserId ?? string.Empty;
                    _error = "This ticket was modified by another user. The latest version has been loaded.";
                    return;
                }

                if (code == "closed_ticket_cannot_be_assigned")
                {
                    _error = "Closed tickets cannot be reassigned.";
                    return;
                }
            }

            _error = await ApiErrorMapper.ToMessageAsync(
                response,
                "Could not update the ticket assignment.");
        }
        catch
        {
            _error = "Could not update the ticket assignment.";
        }
        finally
        {
            _assignmentBusy = false;
        }
    }

    private async Task ChangeStatusAsync(LifecycleAction action)
    {
        if (_ticket is null || _lifecycleBusy)
            return;

        _lifecycleBusy = true;
        _error = null;

        try
        {
            var request = new TicketLifecycleRequestDto
            {
                RowVersionBase64 = _ticket.RowVersionBase64
            };

            var response = action.Action switch
            {
                "start" => await TicketApi.StartAsync(Id, request),
                "resolve" => await TicketApi.ResolveAsync(Id, request),
                "close" => await TicketApi.CloseAsync(Id, request),
                "reopen" => await TicketApi.ReopenAsync(Id, request),
                _ => throw new InvalidOperationException("Unknown lifecycle action.")
            };

            if (response.IsSuccessStatusCode)
            {
                await LoadTicketAsync();
                _selectedAgentId = _ticket?.AssignedToUserId ?? string.Empty;
                _toastMessage = $"Ticket status changed to {action.TargetStatus}.";
                _toastVersion++;
                _toastVisible = true;
                return;
            }

            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                await LoadTicketAsync();
                _selectedAgentId = _ticket?.AssignedToUserId ?? string.Empty;
                _error = "This ticket was modified by another user. The latest version has been loaded.";
                return;
            }

            _error = await ApiErrorMapper.ToMessageAsync(
                response,
                "Could not update the ticket status.");
        }
        catch
        {
            _error = "Could not update the ticket status.";
        }
        finally
        {
            _lifecycleBusy = false;
        }
    }

    private static IReadOnlyList<LifecycleAction> GetLifecycleActions(TicketDto ticket)
    {
        var actions = new List<LifecycleAction>();

        if (ticket.CanStart)
            actions.Add(new("Start work", "start", "InProgress"));

        if (ticket.CanResolve)
            actions.Add(new("Resolve", "resolve", "Resolved"));

        if (ticket.CanClose)
            actions.Add(new("Close", "close", "Closed"));

        if (ticket.CanReopen)
            actions.Add(new("Reopen", "reopen", "InProgress"));

        return actions;
    }

    private static string FormatAgent(AssignableAgentDto agent)
    {
        return string.IsNullOrWhiteSpace(agent.UserName)
            ? agent.DisplayName
            : $"{agent.DisplayName} ({agent.UserName})";
    }

    private static string FormatUtc(DateTime? value) =>
        value.HasValue
            ? $"{value.Value.ToUniversalTime():yyyy-MM-dd HH:mm} UTC"
            : "Unavailable";

    private sealed record LifecycleAction(
        string Label,
        string Action,
        string TargetStatus);

    private async Task LoadTicketAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _ticket = await TicketApi.GetByIdAsync(Id);

            if (_ticket is null)
                _error = "Ticket was not found.";
        }
        catch
        {
            _error = "Could not load ticket details.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadAgentsAsync()
    {
        _agentsLoading = true;

        try
        {
            _agents = await UserApi.GetAssignableAgentsAsync();
            _selectedAgentId = _ticket?.AssignedToUserId ?? string.Empty;
        }
        catch
        {
            _agents = [];
            _error = "Ticket details were loaded, but the list of agents could not be loaded.";
        }
        finally
        {
            _agentsLoading = false;
        }
    }
}
