@page "/tickets/{Id:int}"
@attribute [Authorize]

@using HelpDeskHero.Shared.Contracts.Tickets
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject HelpDeskHero.UI.Services.Api.ITicketApiClient TicketApi
@inject NavigationManager Nav

<PageTitle>Szczegóły zgłoszenia</PageTitle>

<h3>Szczegóły zgłoszenia</h3>

<ErrorBanner Message="@_error" />

@if (_loading)
{
    <LoadingSpinner Text="Ładowanie zgłoszenia..." />
}
else if (_ticket is not null)
{
    <div class="card">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Numer</dt>
                <dd class="col-sm-9">@_ticket.Number</dd>

                <dt class="col-sm-3">Tytuł</dt>
                <dd class="col-sm-9">@_ticket.Title</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    <StatusBadge Status="@_ticket.Status" />
                </dd>

                <dt class="col-sm-3">Priorytet</dt>
                <dd class="col-sm-9">
                    <PriorityBadge Priority="@_ticket.Priority" />
                </dd>

                <dt class="col-sm-3">Opis</dt>
                <dd class="col-sm-9">@_ticket.Description</dd>
            </dl>

            <div class="d-flex gap-2 mt-3">
                <AuthorizeView Roles="Admin,Agent">
                    <Authorized>
                        <button class="btn btn-primary"
                                @onclick='() => Nav.NavigateTo($"/tickets/edit/{Id}")'>
                            Edytuj
                        </button>
                    </Authorized>
                </AuthorizeView>

                <button class="btn btn-secondary"
                        @onclick='() => Nav.NavigateTo("/tickets")'>
                    Powrót
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private TicketDto? _ticket;
    private string? _error;
    private bool _loading;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _ticket = await TicketApi.GetByIdAsync(Id);

            if (_ticket is null)
            {
                _error = "Nie znaleziono zgłoszenia.";
            }
        }
        catch
        {
            _error = "Nie udało się pobrać szczegółów zgłoszenia.";
        }
        finally
        {
            _loading = false;
        }
    }
}