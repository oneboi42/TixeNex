@page "/tickets/create"
@attribute [Authorize]
@using HelpDeskHero.Shared.Contracts.Tickets
@using HelpDeskHero.UI.Services.Api
@inject TicketApiClient TicketApi
@inject NavigationManager Navigation

<PageTitle>Nowe zgloszenie</PageTitle>

<h3>Nowe zgloszenie</h3>

<EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Tytul</label>
        <InputText class="form-control" @bind-Value="_model.Title" />
        <ValidationMessage For="@(() => _model.Title)" />
    </div>

    <div class="mb-3">
        <label>Opis</label>
        <InputTextArea class="form-control" @bind-Value="_model.Description" />
        <ValidationMessage For="@(() => _model.Description)" />
    </div>

    <div class="mb-3">
        <label>Priorytet</label>
        <InputSelect class="form-select" @bind-Value="_model.Priority">
            <option>Low</option>
            <option>Medium</option>
            <option>High</option>
            <option>Critical</option>
        </InputSelect>
        <ValidationMessage For="@(() => _model.Priority)" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    <button class="btn btn-primary" type="submit" disabled="@_busy">Zapisz</button>
</EditForm>

@code {
    private bool _busy;
    private string? _error;
    private CreateTicketDto _model = new();

    private async Task HandleSubmitAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            var result = await TicketApi.CreateAsync(_model);
            if (result is null)
            {
                _error = "Nie udalo sie zapisac zgloszenia.";
                return;
            }

            Navigation.NavigateTo("/tickets");
        }
        catch
        {
            _error = "Wystapil blad podczas zapisu.";
        }
        finally
        {
            _busy = false;
        }
    }
}