@using HelpDeskHero.Shared.Contracts.Tickets
@using HelpDeskHero.UI.Services.Api

@inject TicketCommentApiClient CommentApi

<section class="mt-4">
    <h4>Komentarze</h4>

    <ErrorBanner Message="@_error" />

    @if (_loading)
    {
        <LoadingSpinner Text="Ladowanie komentarzy..." />
    }
    else if (_comments.Count == 0)
    {
        <EmptyState Title="Brak komentarzy" Message="Ten ticket nie ma jeszcze komentarzy." />
    }
    else
    {
        <div class="list-group mb-3">
            @foreach (var comment in _comments)
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between gap-3">
                        <strong>@comment.CreatedByDisplayName</strong>
                        <small class="text-muted">@comment.CreatedAtUtc.ToLocalTime().ToString("g")</small>
                    </div>
                    <div class="mt-2">@comment.Body</div>
                </div>
            }
        </div>
    }

    <EditForm Model="_newComment" OnValidSubmit="HandleCreateAsync">
        <DataAnnotationsValidator />

        <div class="mb-2">
            <label class="form-label" for="@_bodyInputId">Nowy komentarz</label>
            <InputTextArea id="@_bodyInputId"
                           class="form-control"
                           rows="4"
                           maxlength="4000"
                           disabled="@_saving"
                           @bind-Value="_newComment.Body" />
        </div>

        <button class="btn btn-primary" type="submit" disabled="@_saving">
            @(_saving ? "Zapisywanie..." : "Dodaj komentarz")
        </button>
    </EditForm>

    <AppToast @bind-Visible="_toastVisible"
              Title="Komentarz dodany"
              Message="Komentarz zostal zapisany." />
</section>

@code {
    [Parameter]
    public int TicketId { get; set; }

    private readonly string _bodyInputId = $"comment-body-{Guid.NewGuid():N}";
    private List<TicketCommentDto> _comments = [];
    private CreateTicketCommentDto _newComment = new();
    private string? _error;
    private bool _loading;
    private bool _saving;
    private bool _toastVisible;

    protected override async Task OnParametersSetAsync()
    {
        await LoadCommentsAsync();
    }

    private async Task LoadCommentsAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _comments = (await CommentApi.GetAllAsync(TicketId)).ToList();
        }
        catch
        {
            _error = "Nie udalo sie pobrac komentarzy.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleCreateAsync()
    {
        var body = _newComment.Body.Trim();
        if (string.IsNullOrWhiteSpace(body))
        {
            _error = "Komentarz nie moze byc pusty.";
            return;
        }

        if (body.Length > 4000)
        {
            _error = "Komentarz nie moze przekraczac 4000 znakow.";
            return;
        }

        _saving = true;
        _error = null;
        _toastVisible = false;

        try
        {
            var response = await CommentApi.CreateAsync(TicketId, new CreateTicketCommentDto
            {
                Body = body
            });

            if (!response.IsSuccessStatusCode)
            {
                _error = "Nie udalo sie dodac komentarza.";
                return;
            }

            var created = await response.Content.ReadFromJsonAsync<TicketCommentDto>();
            if (created is not null)
            {
                _comments.Add(created);
            }

            _newComment = new CreateTicketCommentDto();
            _toastVisible = true;
        }
        catch
        {
            _error = "Nie udalo sie dodac komentarza.";
        }
        finally
        {
            _saving = false;
        }
    }
}
