@page "/tickets/edit/{Id:int}"
@attribute [Authorize]
@using HelpDeskHero.Shared.Contracts.Tickets
@using HelpDeskHero.UI.Services.Api
@inject TicketApiClient TicketApi
@inject NavigationManager Nav

<PageTitle>Edycja zgłoszenia</PageTitle>

<h3>Edycja zgłoszenia (ID: @Id)</h3>

@if (_isLoading)
{
    <Loading Visible="true" />
}
else if (_model is null)
{
    <ErrorBanner Message="@_error" />
}
else
{
    <EditForm Model="_model" OnValidSubmit="HandleSaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Tytuł</label>
            <InputText class="form-control" @bind-Value="_model.Title" />
            <ValidationMessage For="@(() => _model.Title)" />
        </div>

        <div class="mb-3">
            <label class="form-label">Opis</label>
            <InputTextArea class="form-control" @bind-Value="_model.Description" />
            <ValidationMessage For="@(() => _model.Description)" />
        </div>

        <div class="mb-3">
            <label class="form-label">Status</label>
            <InputSelect class="form-select" @bind-Value="_model.Status">
                <option>New</option>
                <option>InProgress</option>
                <option>Resolved</option>
                <option>Closed</option>
            </InputSelect>
            <ValidationMessage For="@(() => _model.Status)" />
        </div>

        <div class="mb-3">
            <label class="form-label">Priorytet</label>
            <InputSelect class="form-select" @bind-Value="_model.Priority">
                <option>Low</option>
                <option>Medium</option>
                <option>High</option>
                <option>Critical</option>
            </InputSelect>
            <ValidationMessage For="@(() => _model.Priority)" />
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }

        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit" disabled="@_busy">
            @(_busy ? "Zapisywanie..." : "Zapisz zmiany")
            </button>
            <button class="btn btn-danger" type="button" @onclick="HandleDeleteAsync" disabled="@_busy">Usuń</button>
            <a class="btn btn-secondary" href="/tickets/@Id">Anuluj</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] 
    public int Id { get; set; }

    private bool _isLoading = true;
    private bool _busy;
    private string? _error;
    private UpdateTicketDto? _model;

    protected override async Task OnInitializedAsync()
    {
        _error = null;
        try
        {
            var ticket = await TicketApi.GetByIdAsync(Id);
            if (ticket is not null)
            {
                _model = new UpdateTicketDto
                {
                    Title = ticket.Title,
                    Description = ticket.Description,
                    Status = ticket.Status,
                    Priority = ticket.Priority
                };
            }
        }
        catch
        {
            _error = "Nie udało się pobrać danych zgłoszenia.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSaveAsync()
    {
        if (_model is null || _busy) return;

        _busy = true;
        _error = null;

        try
        {
            var success = await TicketApi.UpdateAsync(Id, _model);
            if (!success)
            {
                _error = "Nie udało się zaktualizować zgłoszenia.";
                return;
            }

            Nav.NavigateTo($"/tickets/{Id}");
        }
        catch
        {
            _error = "Wystąpił błąd podczas zapisu zmian.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task HandleDeleteAsync()
    {
        if (_busy) return;

        _busy = true;
        _error = null;

        try
        {
            var success = await TicketApi.DeleteAsync(Id);
            if (!success) 
            {
                _error = "Nie udało się usunąć zgłoszenia.";
                return;
            }

            Nav.NavigateTo("/tickets");
        }
        catch
        {
            _error = "Wystąpił błąd podczas usuwania.";
        }
        finally
        {
            _busy = false;
        }
    }
}