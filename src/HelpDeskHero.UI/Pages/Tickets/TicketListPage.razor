@page "/tickets"
@attribute [Authorize]
@implements IAsyncDisposable

@using HelpDeskHero.Shared.Contracts.Common
@using HelpDeskHero.Shared.Contracts.Tickets
@using HelpDeskHero.UI.Services.Realtime
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject HelpDeskHero.UI.Services.Api.ITicketApiClient TicketApi
@inject NavigationManager Navigation
@inject TicketsRealtimeClient Realtime

@inject IJSRuntime JS

<PageTitle>Zgłoszenia</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">Zgłoszenia</h3>
        <div class="text-muted">Lista zgłoszeń w systemie HelpDeskHero</div>
    </div>

    <AuthorizeView Roles="Admin,Agent">
        <Authorized>
            <NavLink class="btn btn-primary" href="tickets/create">
                Nowe zgłoszenie
            </NavLink>
            <button class="btn btn-outline-secondary" @onclick="ExportCsv">
                Export CSV
            </button>
        </Authorized>
    </AuthorizeView>
</div>

<ErrorBanner Message="@_error" />

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-4">
                <InputText class="form-control"
                           @bind-Value="_query.Search"
                           placeholder="Szukaj..." />
            </div>

            <div class="col-md-2">
                <InputSelect class="form-select" @bind-Value="_query.Status">
                    <option value="">Wszystkie statusy</option>
                    <option value="New">New</option>
                    <option value="InProgress">InProgress</option>
                    <option value="Resolved">Resolved</option>
                    <option value="Closed">Closed</option>
                </InputSelect>
            </div>

            <div class="col-md-2">
                <InputSelect class="form-select" @bind-Value="_query.Priority">
                    <option value="">Wszystkie priorytety</option>
                    <option value="Low">Low</option>
                    <option value="Medium">Medium</option>
                    <option value="High">High</option>
                    <option value="Critical">Critical</option>
                </InputSelect>
            </div>

            <div class="col-md-2">
                <button class="btn btn-primary w-100"
                        disabled="@_loading"
                        @onclick="ReloadAsync">
                    Filtruj
                </button>
            </div>
        </div>
    </div>
</div>

@if (_loading)
{
    <LoadingSpinner Text="Ładowanie zgłoszeń..." />
}
else if (_result is null)
{
    <EmptyState Title="Brak danych"
        Message="Nie udało się wyświetlić listy zgłoszeń." />
}
else
{
    <div class="mb-2 text-muted">
        Łącznie: @_result.TotalCount
    </div>

    @if (!_result.Items.Any())
    {
        <EmptyState Title="Nie znaleziono zgłoszeń"
            Message="Zmień filtry albo utwórz nowe zgłoszenie." />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Nr</th>
                        <th>Tytuł</th>
                        <th>Status</th>
                        <th>Priorytet</th>
                        <th>Utworzono</th>
                        <th class="text-end">Akcje</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in _result.Items)
                    {
                        <tr>
                            <td>@item.Number</td>

                            <td>
                                <a href="@($"/tickets/{item.Id}")">
                                    @item.Title
                                </a>
                            </td>

                            <td>
                                <StatusBadge Status="@item.Status" />
                            </td>

                            <td>
                                <PriorityBadge Priority="@item.Priority" />
                            </td>

                            <td>
                                @item.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            </td>

                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary"
                                            @onclick='() => Navigation.NavigateTo($"/tickets/{item.Id}")'>
                                        Szczegóły
                                    </button>

                                    <AuthorizeView Roles="Admin,Agent">
                                        <Authorized>
                                            <button class="btn btn-outline-primary"
                                                    @onclick='() => Navigation.NavigateTo($"/tickets/edit/{item.Id}")'>
                                                Edytuj
                                            </button>
                                        </Authorized>
                                    </AuthorizeView>

                                    <AuthorizeView Roles="Admin">
                                        <Authorized>
                                            <button class="btn btn-outline-danger"
                                                    @onclick="() => AskDelete(item)">
                                                Usuń
                                            </button>
                                        </Authorized>
                                    </AuthorizeView>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-outline-secondary"
                disabled="@(_query.PageNumber <= 1 || _loading)"
                @onclick="PrevAsync">
            Poprzednia
        </button>

        <span>Strona @_query.PageNumber</span>

        <button class="btn btn-outline-secondary"
                disabled="@((_query.PageNumber * _query.PageSize) >= _result.TotalCount || _loading)"
                @onclick="NextAsync">
            Następna
        </button>
    </div>
}

<AppToast @bind-Visible="_toastVisible"
          Type="@_toastType"
          Title="@_toastTitle"
          Message="@_toastMessage" />

<ConfirmDeleteDialog Visible="@_showDeleteDialog"
                     Busy="@_deleteBusy"
                     Title="Usuwanie zgłoszenia"
                     Message="@_deleteMessage"
                     OnConfirm="DeleteAsync"
                     OnCancel="CancelDelete" />

@code {
    private TicketQueryDto _query = new();
    private PagedResultDto<TicketDto>? _result;

    private bool _loading;
    private bool _deleteBusy;
    private bool _showDeleteDialog;


    private bool _toastVisible;
    private string _toastType = "success";
    private string _toastTitle = "";
    private string? _toastMessage;
    

    private int? _ticketIdToDelete;
    private string? _error;
    private string _deleteMessage = "Czy na pewno chcesz usunąć to zgłoszenie?";

    protected override async Task OnInitializedAsync()
    {
        Realtime.OnTicketChanged += HandleTicketChangedAsync;
        await ReloadAsync();
        await StartRealtimeAsync();
    }

    private void ShowToast(string type, string title, string? message = null)
    {
        _toastType = type;
        _toastTitle = title;
        _toastMessage = message;
        _toastVisible = true;
    }
    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _result = await TicketApi.GetPageAsync(_query);
        }
        catch
        {
            _error = "Nie udało się pobrać listy zgłoszeń.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task StartRealtimeAsync()
    {
        try
        {
            await Realtime.StartAsync();
        }
        catch
        {
            _error ??= "Nie udało się połączyć z aktualizacjami na żywo.";
        }
    }

    private async Task HandleTicketChangedAsync(TicketLiveUpdateDto update)
    {
        await InvokeAsync(async () =>
        {
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private async Task PrevAsync()
    {
        if (_query.PageNumber <= 1)
            return;

        _query.PageNumber--;
        await ReloadAsync();
    }

    private async Task NextAsync()
    {
        _query.PageNumber++;
        await ReloadAsync();
    }

    private void AskDelete(TicketDto ticket)
    {
        _ticketIdToDelete = ticket.Id;
        _deleteMessage = $"Czy na pewno chcesz usunąć zgłoszenie {ticket.Number}?";
        _showDeleteDialog = true;
    }

    private void CancelDelete()
    {
        _showDeleteDialog = false;
        _ticketIdToDelete = null;
    }

    private async Task DeleteAsync()
    {
        if (_ticketIdToDelete is null)
            return;

        _deleteBusy = true;
        _error = null;

        try
        {
            var response = await TicketApi.DeleteAsync(_ticketIdToDelete.Value);

            if (!response.IsSuccessStatusCode)
            {
                _error = "Nie udało się usunąć zgłoszenia.";
                return;
            }

            _showDeleteDialog = false;
            _ticketIdToDelete = null;

            ShowToast("success", "Usunięto zgłoszenie", "Zgłoszenie zostało przeniesione do kosza.");

            await ReloadAsync();
        }
        catch
        {
            _error = "Wystąpił błąd podczas usuwania zgłoszenia.";
        }
        finally
        {
            _deleteBusy = false;
        }
    }


    private async Task ExportCsv()
    {
        var parameters = new List<string>();

        if (!string.IsNullOrWhiteSpace(_query.Status))
            parameters.Add($"status={Uri.EscapeDataString(_query.Status)}");

        if (!string.IsNullOrWhiteSpace(_query.Priority))
            parameters.Add($"priority={Uri.EscapeDataString(_query.Priority)}");

        var queryString = parameters.Count > 0
            ? "?" + string.Join("&", parameters)
            : "";

        var url = $"https://localhost:5001/api/tickets/export{queryString}";

        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    public ValueTask DisposeAsync()
    {
        Realtime.OnTicketChanged -= HandleTicketChangedAsync;
        return ValueTask.CompletedTask;
    }
}
