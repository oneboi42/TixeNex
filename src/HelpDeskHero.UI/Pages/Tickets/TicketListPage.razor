@page "/tickets"
@attribute [Authorize]
@using HelpDeskHero.Shared.Contracts.Tickets
@inject HelpDeskHero.UI.Services.Api.TicketApiClient TicketApi
@inject NavigationManager Nav

<PageTitle>Tickets</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Tickets</h3>

    <button class="btn btn-primary"
            @onclick='() => Nav.NavigateTo("/tickets/create")'>
        Nowe zgłoszenie
    </button>
</div>

<Loading Visible="@_isLoading" />

@if (!_isLoading && _tickets.Count == 0)
{
    <p>Brak zgłoszeń.</p>
}
else if (!_isLoading)
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Number</th>
                <th>Title</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ticket in _tickets)
            {
                <tr>
                    <td>@ticket.Number</td>
                    <td>@ticket.Title</td>
                    <td>
                        <StatusBadge Status="@ticket.Status" />
                    </td>
                    <td>
                        <PriorityBadge Priority="@ticket.Priority" />
                    </td>
                    <td>
                        <div class="btn-group">
                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick='() => Nav.NavigateTo($"/tickets/{ticket.Id}")'>
                                Szczegóły
                            </button>

                            <button class="btn btn-sm btn-outline-secondary"
                                    @onclick='() => Nav.NavigateTo($"/tickets/edit/{ticket.Id}")'>
                                Edytuj
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool _isLoading = true;
    private List<TicketDto> _tickets = new();

    protected override async Task OnInitializedAsync()
    {
        _tickets = (await TicketApi.GetAllAsync()).ToList();
        _isLoading = false;
    }
}