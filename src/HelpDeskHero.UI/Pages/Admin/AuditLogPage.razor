@page "/admin/audit"
@attribute [Authorize(Roles = "Admin")]

@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization

@inject HttpClient Http

<PageTitle>Audit Log</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">Audit Log</h3>
        <div class="text-muted">Ostatnie operacje wykonane w systemie</div>
    </div>

    <button class="btn btn-outline-primary"
            disabled="@_loading"
            @onclick="LoadAsync">
        Odśwież
    </button>
    <NavLink class="btn btn-outline-secondary" href="tickets/deleted">
        Przejdź do kosza
    </NavLink>
</div>

<ErrorBanner Message="@_error" />

@if (_loading)
{
    <LoadingSpinner Text="Ładowanie wpisów audytu..." />
}
else if (_items.Count == 0)
{
    <div class="alert alert-info">
        Brak wpisów audytu.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Data</th>
                    <th>Akcja</th>
                    <th>Encja</th>
                    <th>ID encji</th>
                    <th>Użytkownik</th>
                    <th>IP</th>
                    <th>Szczegóły</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in _items)
                {
                    <tr>
                        <td>@item.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>
                            <span class="badge @GetActionBadge(item.Action)">
                                @item.Action
                            </span>
                        </td>
                        <td>@item.EntityName</td>
                        <td>@item.EntityId</td>
                        <td>@(item.UserName ?? "-")</td>
                        <td>@(item.IpAddress ?? "-")</td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(item.DetailsJson))
                            {
                                <span class="text-muted">-</span>
                            }
                            else
                            {
                                <code>@item.DetailsJson</code>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<AuditLogItem> _items = [];
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var result = await Http.GetFromJsonAsync<List<AuditLogItem>>("api/audit");
            _items = result ?? [];
        }
        catch
        {
            _error = "Nie udało się pobrać wpisów audytu.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string GetActionBadge(string action)
    {
        return action switch
        {
            "Create" => "bg-success",
            "Update" => "bg-primary",
            "SoftDelete" => "bg-danger",
            "Delete" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private sealed class AuditLogItem
    {
        public long Id { get; set; }
        public DateTime CreatedAtUtc { get; set; }
        public string Action { get; set; } = string.Empty;
        public string EntityName { get; set; } = string.Empty;
        public string EntityId { get; set; } = string.Empty;
        public string? UserId { get; set; }
        public string? UserName { get; set; }
        public string? IpAddress { get; set; }
        public string? DetailsJson { get; set; }
    }
}