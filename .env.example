# Required production credentials and secrets.
# Supply every value before startup.

# SQL Server administrator password.
# Generate a strong unique password.
MSSQL_SA_PASSWORD=

# JWT signing key, at least 32 characters.
# Generate with: openssl rand -base64 32
JWT_KEY=

# Initial seeded application account passwords.
# Use unique strong passwords for each account.
SEED_ADMIN_PASSWORD=
SEED_AGENT_PASSWORD=
SEED_USER_PASSWORD=

# RabbitMQ credentials.
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# MinIO root credentials.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=